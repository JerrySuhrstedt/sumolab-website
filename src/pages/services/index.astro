---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import PrimaryCTA from "../../components/PrimaryCTA.astro";
import { services } from "../../data/services";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "SumoLab Services",
	itemListElement: services.map((service, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "Service",
			name: service.name,
			description: service.tagline,
			url: `https://sumolab.co/services/${service.slug}/`,
		},
	})),
};
---

<Layout
	title="Services | SumoLab"
	description="Three ways to put senior leadership to work: Fractional CMO, Fractional Marketing Director, and Fractional AI Advisor for established businesses."
	structuredData={structuredData}
>
	<main>
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/services-hero-leadership.jpg"
				alt="Senior business leader standing confidently in an office after a strategy session"
				width="1920"
				height="1080"
				class="absolute inset-0 h-full w-full object-cover object-[75%_center]"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-brand-ink/85 via-brand-ink/60 to-brand-ink/25" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-(--container-content) px-6 py-10 md:px-10 md:py-14 lg:px-12">
				<Eyebrow tone="citrus">Services</Eyebrow>
				<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-offwhite">
					Three ways to put senior leadership to work.
				</h1>
				<p class="text-supporting mt-6 max-w-2xl text-brand-offwhite/85">
					All three run on the same fractional principle: senior leadership without the full-time cost. Two are
					marketing-specific, board-level strategy versus hands-on operational leadership. The third looks across
					your whole business to find where AI actually belongs.
				</p>
			</div>
		</section>

		<Section tone="white">
			<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
				{services.map((service) => <ServiceCard service={service} />)}
			</div>
		</Section>

		<Section tone="purple">
			<div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
				<h2 class="text-statement max-w-xl text-huge text-brand-white">
					Not sure which one fits your situation?
				</h2>
				<PrimaryCTA tone="citrus" ring="citrus" label="Discuss Your Growth" />
			</div>
		</Section>
	</main>
</Layout>
